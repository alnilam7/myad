<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lumière Candles</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #fffaf4;
      color: #3f3028;
    }

    /* NAVBAR */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 8%;
      background: #fffaf4;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 30px;
    }

    nav a {
      text-decoration: none;
      color: #3f3028;
      font-size: 15px;
    }

    nav a:hover {
      color: #a66b45;
    }

    /* HERO */
    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 60px 8%;
      background: #f4e7d7;
    }

    .hero-text {
      max-width: 520px;
    }

    .hero-text small {
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #9b6848;
    }

    .hero-text h1 {
      font-size: 60px;
      line-height: 1.1;
      margin: 20px 0;
    }

    .hero-text p {
      font-size: 17px;
      line-height: 1.7;
      margin-bottom: 30px;
      color: #665047;
    }

    .btn {
      display: inline-block;
      padding: 14px 30px;
      background: #3f3028;
      color: white;
      text-decoration: none;
      border-radius: 30px;
      transition: 0.3s;
    }

    .btn:hover {
      background: #9b6848;
    }

    .hero-candle {
      width: 300px;
      height: 400px;
      border-radius: 150px 150px 40px 40px;
      background: linear-gradient(to right, #fff, #ead8c4);
      box-shadow: 20px 25px 50px rgba(80,50,30,0.2);
      position: relative;
      margin-right: 8%;
    }

    .flame {
      position: absolute;
      width: 35px;
      height: 55px;
      background: #e8a64d;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      top: -65px;
      left: 132px;
      box-shadow: 0 0 30px #e8a64d;
    }

    /* PRODUCTS */
    .products {
      padding: 80px 8%;
      text-align: center;
    }

    .products h2 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #806b5d;
      margin-bottom: 45px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(70,40,20,0.08);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-8px);
    }

    .candle-img {
      height: 280px;
      border-radius: 15px;
      background: #eee0d0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }

    .card h3 {
      margin: 18px 0 8px;
    }

    .price {
      color: #a66b45;
      font-weight: bold;
      font-size: 18px;
    }

    /* ABOUT */
    .about {
      padding: 80px 12%;
      background: #ead9c6;
      text-align: center;
    }

    .about h2 {
      font-size: 38px;
      margin-bottom: 20px;
    }

    .about p {
      max-width: 700px;
      margin: auto;
      line-height: 1.8;
      color: #604c40;
    }

    /* CONTACT */
    .contact {
      padding: 70px 8%;
      text-align: center;
    }

    .contact h2 {
      font-size: 35px;
      margin-bottom: 20px;
    }

    .contact p {
      margin: 10px;
    }

    /* FOOTER */
    footer {
      background: #3f3028;
      color: white;
      text-align: center;
      padding: 25px;
    }

    /* MOBILE */
    @media (max-width: 768px) {

      nav ul {
        display: none;
      }

      .hero {
        flex-direction: column;
        text-align: center;
      }

      .hero-text h1 {
        font-size: 42px;
      }

      .hero-candle {
        margin: 80px 0 20px;
        width: 220px;
        height: 300px;
      }

      .flame {
        left: 92px;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="logo">LUMIÈRE</div>

    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#shop">Shop</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>


  <!-- HERO -->
  <section class="hero" id="home">

    <div class="hero-text">
      <small>Handcrafted with love</small>

      <h1>Light up your little moments.</h1>

      <p>
        Beautiful handmade candles created to make
        your home feel warm, peaceful and special.
      </p>

      <a href="#shop" class="btn">Shop Collection</a>
    </div>

    <div class="hero-candle">
      <div class="flame"></div>
    </div>

  </section>


  <!-- PRODUCTS -->
  <section class="products" id="shop">

    <h2>Our Collection</h2>

    <p class="subtitle">
      Find your perfect scent.
    </p>

    <div class="product-grid">

      <div class="card">
        <div class="candle-img">🕯️</div>
        <h3>Vanilla Dream</h3>
        <p>Soft vanilla & warm sugar</p>
        <br>
        <div class="price">৳ 650</div>
      </div>

      <div class="card">
        <div class="candle-img">🌸</div>
        <h3>Rose Garden</h3>
        <p>Fresh rose & soft floral notes</p>
        <br>
        <div class="price">৳ 750</div>
      </div>

      <div class="card">
        <div class="candle-img">🌿</div>
        <h3>Lavender Calm</h3>
        <p>Relaxing lavender & herbs</p>
        <br>
        <div class="price">৳ 700</div>
      </div>

    </div>

  </section>


  <!-- ABOUT -->
  <section class="about" id="about">

    <h2>Our Story</h2>

    <p>
      At Lumière, we believe a candle is more than just a light.
      Every candle is carefully handcrafted with beautiful scents
      and simple elegant designs to bring warmth and calm into
      your everyday life.
    </p>

  </section>


  <!-- CONTACT -->
  <section class="contact" id="contact">

    <h2>Let's Connect</h2>

    <p>📧 hello@lumiere.com</p>
    <p>📱 +880 1XXXXXXXXX</p>
    <p>📍 Dhaka, Bangladesh</p>

    <br>

    <a href="mailto:hello@lumiere.com" class="btn">
      Contact Us
    </a>

  </section>


  <!-- FOOTER -->
  <footer>
    © 2026 Lumière Candles — Made with love 🕯️
  </footer>

</body>
</html>
